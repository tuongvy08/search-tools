# Add inside the existing authenticated app's server; preserve its TLS and
# trusted proxy configuration. Does not introduce another public upstream.
location /admin/imports {
    client_max_body_size 129m;  # IMPORT_MAX_BYTES=128 MiB plus multipart overhead
    client_body_timeout 120s;
    proxy_request_buffering on;
    proxy_connect_timeout 10s;
    proxy_send_timeout 180s;
    proxy_read_timeout 180s;    # only file transfer/admission; parsing is in worker
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://127.0.0.1:8000;
}
# Use the same upload limit for Gunicorn/Flask and size Nginx's body-temp disk.
# Gunicorn example: --workers 3 --timeout 180 --graceful-timeout 30
